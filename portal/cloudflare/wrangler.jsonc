{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "fastconnect-dev",
  "main": "src/index.js",
  "compatibility_date": "2026-10-02",
  "workers_dev": true,
  "triggers": {
    "crons": ["0 * * * *"]
  },
  "assets": {
    "directory": "../public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*",
      "/health"
    ]
  },
  "observability": {
    "enabled": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fastconnect-dev",
      "database_id": "0c7808f0-e157-44bf-a745-b8eb7b0b7d8c",
      "migrations_dir": "migrations"
    }
  ]
}
